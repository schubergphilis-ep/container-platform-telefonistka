# Telefonistka Development Environment
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Provider Selection ---
# Auto-detected from CI environment (GITLAB_CI / GITHUB_ACTIONS).
# Set explicitly to override:
# TELEFONISTKA_PROVIDER=github

# --- GitHub Configuration ---
# OAuth token (required for GitHub provider, unless using GitHub App)
GITHUB_OAUTH_TOKEN=

# GitHub App credentials (alternative to OAuth token)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# GitHub webhook secret (required unless ALLOW_UNSIGNED_WEBHOOKS=true)
GITHUB_WEBHOOK_SECRET=

# GitHub Enterprise (optional)
# GITHUB_HOST=github.example.com

# --- GitLab Configuration ---
# GitLab API token (required for GitLab provider)
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# GitLab webhook secret (required unless ALLOW_UNSIGNED_WEBHOOKS=true)
GITLAB_WEBHOOK_SECRET=

# GitLab auto-approver token (optional, for automatic MR approval)
# GITLAB_APPROVER_TOKEN=

# GitLab project ID (optional, auto-detected from webhook)
# GITLAB_PROJECT_ID=

# Skip TLS verification for self-hosted GitLab (NOT recommended for production)
# GITLAB_INSECURE=false

# --- ArgoCD Integration (optional) ---
# ARGOCD_SERVER_ADDR=localhost:8080
# ARGOCD_TOKEN=
# ARGOCD_PLAINTEXT=false
# ARGOCD_INSECURE=false

# --- Server Configuration ---
# Allows running without webhook secrets (NOT recommended for production)
# ALLOW_UNSIGNED_WEBHOOKS=false

# Log level (debug, info, warn, error)
LOG_LEVEL=info
